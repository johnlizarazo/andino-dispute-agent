{
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(uv run pytest *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Bash(grep * .env*)",
      "Bash(cp .env* *)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Copy-Item *.env* *)",
      "PowerShell(Select-String * *.env*)"
    ]
  },
  "env": {
    "PYTHONUTF8": "1"
  },
  "extraKnownMarketplaces": {
    "banco-andino": {
      "source": { "source": "directory", "path": "./" }
    }
  },
  "enabledPlugins": {
    "andino-guardrails@banco-andino": true
  }
}
